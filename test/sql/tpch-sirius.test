104 27.0 1995-03-10 2

query IRTI rowsort
CALL gpu_processing('select
  li.l_orderkey,
  sum(li.l_extendedprice * (1 - li.l_discount)) as revenue,
  ord.o_orderdate,
  ord.o_shippriority
from
  customer as cust
  join orders as ord on ord.o_custkey = cust.c_custkey
  join lineitem as li on ord.o_orderkey = li.l_orderkey
where
  cust.c_mktsegment = ''HOUSEHOLD''
  AND ord.o_orderdate < date ''1995-03-25''
  AND li.l_shipdate > date ''1995-03-25''
group by
  li.l_orderkey,
  ord.o_orderdate,
  ord.o_shippriority
order by
  revenue desc,
  ord.o_orderdate
limit 10;');
----
101 140.0 1995-03-01 1
104 27.0 1995-03-10 2

